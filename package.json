    "receipt-constraints": "vite-node scripts/receipt-constraints.ts",
    "receipt-aspirational": "vite-node scripts/receipt-aspirational.ts",
    "fetch-mintlify-schema": "curl -sSL -o src/formats/__tests__/fixtures/mintlify/schema/docs.schema.json https://mintlify.com/docs.json"
  },
